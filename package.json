{
  "name": "serenity-web",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "preinstall": "npx --yes --loglevel=error only-allow npm",
    "start": "next start",
    "dev": "next dev",
    "clean": "rimraf node_modules .next .vercel/cache",
    "reinstall": "npm run clean && npm ci",
    "vc": "vc",
    "vc:prod": "vc --prod",
    "build": "next build",
    "export": "next export",
    "format": "prettier --config .prettierrc --write './src/**/*.{ts,tsx,css}'",
    "type-check": "tsc --noEmit -p .",
    "type-check:watch": "npm run type-check -- --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "vendor-components": "node scripts/vendor-components.mjs",
    "vendor-components:list": "node scripts/vendor-components.mjs list",
    "vendor-components:discover": "node scripts/vendor-components.mjs discover",
    "vendor-components:sync": "node scripts/vendor-components.mjs sync",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run type-check && npm run lint && npm run build && npm run audit",
    "deps:check": "npm outdated || true",
    "deps:upgrade": "npx --yes npm-check-updates --interactive --format group --target minor",
    "deps:upgrade:major": "npx --yes npm-check-updates --interactive --format group --target latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/node": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vercel": "^59.23.2"
  }
}
