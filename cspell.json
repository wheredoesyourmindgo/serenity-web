{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "ignorePaths": [
    ".agents/**",
    ".claude/**",
    ".gitignore",
    "package-lock.json",
    "src/public/static/fonts/fontawesome/**"
  ],
  "ignoreRegExpList": [
    "/\\w*&[a-z]+;\\w*/g"
  ],
  "ignoreWords": [],
  "import": [],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project-words"
  ]
}
